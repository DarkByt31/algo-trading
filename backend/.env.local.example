# Docker-specific environment file (copy to .env.local for docker-compose)
# This is NOT included in git - manage secrets carefully!

# Database (used by docker-compose)
DB_ROOT_PASSWORD=rootpassword
DB_NAME=algo_trading
DB_USER=trader
DB_PASSWORD=traderpass
DB_PORT=3306

# Application
APP_PORT=8000
DEBUG=False
LOG_LEVEL=INFO

# Kite Connect API (get from https://kite.trade)
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here
KITE_ACCESS_TOKEN=your_access_token_here

# Max backtest days
MAX_BACKTEST_DAYS=90
