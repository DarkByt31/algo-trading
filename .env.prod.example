# Production Environment Configuration
# Copy this to .env and fill in your actual values
# NEVER commit .env to git

# ============================================
# Database Configuration (Required)
# ============================================
# Strong password: at least 16 chars, mixed case, numbers, special chars
DB_ROOT_PASSWORD=ChangeThisToAStrongPassword123!ChangeThis
DB_NAME=algo_trading
DB_USER=trader
DB_PASSWORD=ChangeThisToAnotherStrongPassword456!ChangeThis
DB_PORT=3306

# ============================================
# Application Configuration
# ============================================
APP_PORT=8000
DEBUG=False
LOG_LEVEL=INFO
MAX_BACKTEST_DAYS=90

# ============================================
# Kite Connect API Configuration (Required)
# Get these from https://kite.trade
# ============================================
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here
KITE_ACCESS_TOKEN=your_access_token_here

# ============================================
# Production URL Configuration (Optional but recommended for Traefik/SSL)
# ============================================
DOMAIN=yourdomain.com
LETSENCRYPT_EMAIL=your-email@example.com

# ============================================
# Security Notes
# ============================================
# - Generate strong random passwords using: openssl rand -base64 32
# - Rotate API keys before first production deploy
# - Never share or log these values
# - Use AWS Secrets Manager, HashiCorp Vault, or similar in production
